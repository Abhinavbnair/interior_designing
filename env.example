# Copy to .env and fill in — never commit the real .env file.

# LLM / VLM provider (swappable — see app/llm/provider.py)
LLM_PROVIDER=anthropic          # anthropic (real) | fake (heuristic dry-run, no key) | mock (test suite only)
LLM_API_KEY=

# Diffusion model IDs (swap without touching code)
DIFFUSION_BASE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
CONTROLNET_DEPTH_MODEL=diffusers/controlnet-depth-sdxl-1.0
IP_ADAPTER_REPO=h94/IP-Adapter

# Phase 2 — image-to-image only
INPUT_IMAGE_PATH=
STRENGTH=0.6

# Phase 3 — ControlNet (structural conditioning) only
CONTROLNET_DEPTH_MODEL=diffusers/controlnet-depth-sdxl-1.0
DEPTH_MODEL=Intel/dpt-hybrid-midas
VAE_MODEL_ID=madebyollin/sdxl-vae-fp16-fix
CONTROLNET_CONDITIONING_SCALE=0.8

# Remote GPU inference endpoint (Kaggle/Colab-hosted), if generation is not local
GENERATION_BACKEND_URL=

# Paths
MODEL_CACHE_DIR=./models
DATA_DIR=./data

# Phases 5-9 — LLM/VLM constraint extraction + verification
LLM_MODEL=claude-sonnet-4-20250514
MAX_REFINEMENT_ITERATIONS=3

# Phase 9 experiments
TEST_CASES=data/test_cases.json
MAX_CASES=0                    # 0 = all cases
